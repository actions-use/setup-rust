{
  "name": "setup-rust",
  "version": "0.0.0",
  "description": "Install the Rust toolchain",
  "type": "module",
  "scripts": {
    "dev": "tsc --watch",
    "build": "npm run check && rslib build",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions-use/setup-rust.git"
  },
  "keywords": [
    "setup-rust"
  ],
  "author": "nashaofu",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/actions-use/setup-rust/issues"
  },
  "homepage": "https://github.com/actions-use/setup-rust#readme",
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@rslib/core": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0"
  }
}
